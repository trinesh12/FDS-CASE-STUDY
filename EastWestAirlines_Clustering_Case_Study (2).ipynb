      "source": [
        "# Standardise column names a little for easier coding, preserving a mapping for reference.\n",
        "df = df.copy()\n",
        "df.columns = [str(c).strip() for c in df.columns]\n",
        "df = df.drop_duplicates().reset_index(drop=True)\n",
        "\n",
        "# Identify and remove ID-like columns from model features.\n",
        "id_cols = [c for c in df.columns if c.strip().lower() in {\"id\", \"id#\", \"customer_id\", \"customerid\"}]\n",
        "print(\"Identifier columns excluded from clustering:\", id_cols)\n",
        "\n",
        "# Try converting every non-ID column to numeric where possible.\n",
        "work = df.drop(columns=id_cols, errors=\"ignore\").copy()\n",
        "for col in work.columns:\n",
        "    work[col] = pd.to_numeric(work[col], errors=\"coerce\")\n",
        "\n",
        "# Drop columns that contain no usable numeric data.\n",
        "all_missing_cols = work.columns[work.isna().all()].tolist()\n",
        "if all_missing_cols:\n",
        "    print(\"Dropping columns with no numeric values:\", all_missing_cols)\n",
        "    work = work.drop(columns=all_missing_cols)\n",
        "\n",
        "# Remove constant columns because they cannot help form clusters.\n",
        "constant_cols = [c for c in work.columns if work[c].nunique(dropna=True) <= 1]\n",
        "if constant_cols:\n",
        "    print(\"Dropping constant columns:\", constant_cols)\n",
        "    work = work.drop(columns=constant_cols)\n",
        "\n",
        "# Median imputation.\n",
        "work = work.fillna(work.median(numeric_only=True))\n",
        "\n",
        "# IQR-based capping: values outside Q1 - 1.5*IQR and Q3 + 1.5*IQR are capped.\n",
        "# This reduces the impact of extreme values without deleting customer records.\n",
        "for col in work.columns:\n",
        "    q1 = work[col].quantile(0.25)\n",
        "    q3 = work[col].quantile(0.75)\n",
        "    iqr = q3 - q1\n",
        "    if iqr > 0:\n",
        "        lower = q1 - 1.5 * iqr\n",
        "        upper = q3 + 1.5 * iqr\n",
        "        work[col] = work[col].clip(lower, upper)\n",
        "\n",
        "print(\"Rows after removing duplicates:\", len(work))\n",
        "print(\"Features used for clustering:\", work.columns.tolist())\n",
        "print(\"Remaining missing values:\", int(work.isna().sum().sum()))\n",
        "display(work.head())"
      ]
    },
