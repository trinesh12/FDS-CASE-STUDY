      "id": "a28ba797",
      "metadata": {
        "id": "a28ba797"
      },
      "source": [
        "### 5.2 Correlation heatmap\n",
        "\n",
        "Correlation shows which numerical features tend to increase together. It does not prove that one feature causes another."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 7,
      "id": "a6d5a34e",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 791
        },
        "id": "a6d5a34e",
        "outputId": "98f29b0e-9929-4c7f-e8c1-6c35cd4bf8b0"
      },
      "outputs": [
        {
