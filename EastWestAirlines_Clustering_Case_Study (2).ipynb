        "hier_results = []\n",
        "hier_labels_by_linkage = {}\n",
        "\n",
        "for linkage in [\"ward\", \"complete\", \"average\"]:\n",
        "    model = AgglomerativeClustering(n_clusters=BEST_K, linkage=linkage)\n",
        "    labels = model.fit_predict(X_hier)\n",
        "    score = silhouette_score(\n",
        "        X_hier, labels,\n",
        "        sample_size=min(1000, len(X_hier)),\n",
        "        random_state=RANDOM_STATE\n",
        "    ) if len(np.unique(labels)) > 1 else np.nan\n",
        "    hier_results.append({\"Linkage\": linkage, \"Clusters\": len(np.unique(labels)), \"Silhouette Score\": score})\n",
        "    hier_labels_by_linkage[linkage] = labels\n",
        "\n",
        "hier_results_df = pd.DataFrame(hier_results).sort_values(\"Silhouette Score\", ascending=False)\n",
        "display(hier_results_df)"
      ]
    },
