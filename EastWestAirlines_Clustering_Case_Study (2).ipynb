      "source": [
        "eps_values = [0.5, 0.8, 1.0, 1.2, 1.5, 2.0]\n",
        "dbscan_results = []\n",
        "dbscan_labels_by_eps = {}\n",
        "\n",
        "for eps in eps_values:\n",
        "    model = DBSCAN(eps=eps, min_samples=min_samples_value)\n",
        "    labels = model.fit_predict(X_scaled)\n",
        "    dbscan_labels_by_eps[eps] = labels\n",
        "\n",
        "    cluster_ids = set(labels) - {-1}\n",
        "    n_clusters = len(cluster_ids)\n",
        "    noise_pct = (labels == -1).mean() * 100\n",
        "\n",
        "    non_noise_mask = labels != -1\n",
        "    score = np.nan\n",
        "    # Silhouette needs at least 2 clusters and fewer clusters than data points.\n",
        "    if n_clusters >= 2 and non_noise_mask.sum() > n_clusters:\n",
        "        X_eval = X_scaled[non_noise_mask]\n",
        "        y_eval = labels[non_noise_mask]\n",
        "        if len(X_eval) > 2000:\n",
        "            idx = rng.choice(len(X_eval), size=2000, replace=False)\n",
        "            X_eval, y_eval = X_eval[idx], y_eval[idx]\n",
        "        if len(np.unique(y_eval)) >= 2 and len(np.unique(y_eval)) < len(y_eval):\n",
        "            score = silhouette_score(X_eval, y_eval)\n",
        "\n",
        "    dbscan_results.append({\n",
        "        \"eps\": eps,\n",
        "        \"min_samples\": min_samples_value,\n",
        "        \"Clusters (excluding noise)\": n_clusters,\n",
        "        \"Noise (%)\": round(noise_pct, 2),\n",
        "        \"Silhouette (non-noise only)\": score\n",
        "    })\n",
        "\n",
        "dbscan_results_df = pd.DataFrame(dbscan_results)\n",
        "display(dbscan_results_df)"
      ]
    },
