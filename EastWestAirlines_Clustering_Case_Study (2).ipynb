      "source": [
        "### 8.2 Select and plot a DBSCAN result\n",
        "\n",
        "Choose an `eps` that produces a meaningful number of clusters without labelling almost every customer as noise or merging almost everyone into one cluster. The default below selects the first tested setting with at least two clusters; change it after reviewing the results."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 19,
      "id": "204af1bb",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 670
        },
        "id": "204af1bb",
        "outputId": "63f73fb2-ccb8-4b86-a721-1f5a85c749fe"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Selected eps: 1.5\n",
            "Clusters excluding noise: 4\n",
            "Noise points: 185\n",
            "Noise percentage: 4.63 %\n"
          ]
        },
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 900x600 with 1 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ],
      "source": [
        "valid_eps = [\n",
        "    eps for eps, labels in dbscan_labels_by_eps.items()\n",
        "    if len(set(labels) - {-1}) >= 2\n",
        "]\n",
        "if valid_eps:\n",
        "    # Prefer the valid tested value with the highest silhouette, if available.\n",
        "    valid_rows = dbscan_results_df[\n",
        "        dbscan_results_df[\"eps\"].isin(valid_eps)\n",
        "    ].dropna(subset=[\"Silhouette (non-noise only)\"])\n",
        "    if not valid_rows.empty:\n",
        "        BEST_EPS = float(valid_rows.sort_values(\"Silhouette (non-noise only)\", ascending=False).iloc[0][\"eps\"])\n",
        "    else:\n",
        "        BEST_EPS = valid_eps[0]\n",
        "else:\n",
        "    BEST_EPS = eps_values[0]\n",
        "    print(\"Warning: no tested eps produced 2 or more non-noise clusters. Review the k-distance plot and eps_values.\")\n",
        "\n",
        "dbscan_labels = dbscan_labels_by_eps[BEST_EPS]\n",
        "print(\"Selected eps:\", BEST_EPS)\n",
        "print(\"Clusters excluding noise:\", len(set(dbscan_labels) - {-1}))\n",
        "print(\"Noise points:\", int((dbscan_labels == -1).sum()))\n",
        "print(\"Noise percentage:\", round((dbscan_labels == -1).mean() * 100, 2), \"%\")\n",
        "\n",
        "db_plot_df = pd.DataFrame({\n",
        "    \"PC1\": X_pca[:, 0],\n",
        "    \"PC2\": X_pca[:, 1],\n",
        "    \"Cluster\": dbscan_labels.astype(str)\n",
        "})\n",
        "plt.figure(figsize=(9, 6))\n",
        "sns.scatterplot(data=db_plot_df, x=\"PC1\", y=\"PC2\", hue=\"Cluster\", palette=\"tab10\", s=25, alpha=0.7)\n",
        "plt.title(f\"DBSCAN Clusters (PCA 2D View, eps={BEST_EPS})\")\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    },
